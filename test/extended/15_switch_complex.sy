int main() {
    int x = 1;
    int y = 2;
    int result = 0;
    
    switch (x + y) {
        case 1:
            result = 100;
            break;
        case 2:
            result = 200;
            break;
        case 3:
            // 嵌套switch
            switch (x) {
                case 1:
                    result = 301;
                    break;
                case 2:
                    result = 302;
                    break;
                default:
                    result = 300;
            }
            break;
        default:
            result = 400;
    }
    
    putint(result);
    putch(10);
    return 0;
}
